#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
version=v2026.09.27
platform="$(uname -s)-$(uname -m)"
case "$platform" in
    Darwin-arm64) checksum=42d052c4535cd091273df9521027060d836aad48c0028334f1c757b877af89bf ;;
    Darwin-x86_64) checksum=8c976b826d4433b076b69b5e53b6f2f4a419131dd1edde9b054783a6c8fb6928 ;;
    Linux-aarch64) checksum=d4595e8a8ea4b9cc6c2d15c945a5188cf0ab4f4f01247ae2cce60c6d4ffd82e2 ;;
    Linux-x86_64) checksum=cafbbb8960efeb26f5d30bc447b61ab8a507968948507a2580585afd1397781d ;;
    *) echo "Unsupported platform: $platform (Unix required)" >&2; exit 1 ;;
esac
mkdir -p .tools
if [ ! -x .tools/fstar/bin/fstar.exe ]; then
    archive=.tools/fstar-release.tar.gz
    curl -fL --retry 2 -o "$archive" \
        "https://github.com/FStarLang/FStar/releases/download/$version/fstar-$version-$platform.tar.gz"
    if command -v sha256sum >/dev/null; then
        actual=$(sha256sum "$archive" | cut -d ' ' -f 1)
    else
        actual=$(shasum -a 256 "$archive" | cut -d ' ' -f 1)
    fi
    [ "$actual" = "$checksum" ] || { echo 'F* archive checksum mismatch' >&2; exit 1; }
    tar -xzf "$archive" -C .tools
    rm "$archive"
fi
if [ ! -x .tools/ocaml/bin/ocamlfind ] && ! command -v ocamlfind >/dev/null; then
    command -v nix >/dev/null || {
        echo 'Install OCaml 5.3+, findlib, batteries, stdint, ppx_deriving and ppx_deriving_yojson, or install Nix and rerun.' >&2
        exit 1
    }
    nix build --out-link .tools/ocaml .#toolchain
fi
echo 'Toolchain ready. Run make test.'
